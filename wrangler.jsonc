{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hwagok-c-zone",
  "compatibility_date": "2026-04-22",
  // 방문·클릭 집계(/api/hit)만 Worker가 받고, 나머지 요청은 정적 파일이 그대로 응답한다.
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /google*·/naver*: 검색 사이트 소유 확인 파일을 .html 주소 그대로 내주기 위함 (worker.js 참고)
    "run_worker_first": ["/api/*", "/google*", "/naver*"],
    // 없는 경로는 404 대신 index.html을 그대로 돌려준다.
    // 유입 채널용 경로(/k, /s, /f)와 추적용 가상 경로가 주소를 유지한 채 동작하게 하기 위함.
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hwagok-stats",
      "database_id": "aadfb053-bcbe-4d25-86df-f579d4b139fe"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
